// Generated by matugen for Hush. Logo: the Breath mark in the theme primary (kitty graphics).
// Terminals without kitty graphics: fastfetch --logo-type file --logo ~/.config/fastfetch/logo.txt --logo-color-1 <hex>
{
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/hush-logo.png",
    "width": 18,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{colors.primary.default.hex}}", "title": "{{colors.on_surface.default.hex}}" },
    "key": { "width": 10 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "wm" },
    { "type": "custom", "key": "shell", "format": "hush" },
    { "type": "custom", "key": "theme", "format": "{{mode}} · {{colors.primary.default.hex}}" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory" },
    { "type": "uptime", "key": "uptime" },
    { "type": "break" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
