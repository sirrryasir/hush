#!/usr/bin/env bash
# Installs the Hush UI fonts into the user font directory. No sudo.
set -euo pipefail
dest="$HOME/.local/share/fonts/hush"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$dest"

if ! fc-list : family | grep -q '^Inter'; then
  echo "hush-fonts: installing Inter"
  curl -fsSL -o "$tmp/inter.zip" "https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip"
  mkdir -p "$tmp/inter" && (cd "$tmp/inter" && unzip -q ../inter.zip)
  find "$tmp/inter" -name 'InterVariable*.ttf' -exec cp {} "$dest/" \;
  ls "$dest"/InterVariable*.ttf >/dev/null 2>&1 || { echo "hush-fonts: no InterVariable fonts found in the zip" >&2; exit 1; }
fi

if ! fc-list : family | grep -q 'Material Symbols Rounded'; then
  echo "hush-fonts: installing Material Symbols Rounded"
  curl -fsSL -o "$dest/MaterialSymbolsRounded.ttf" \
    "https://github.com/google/material-design-icons/raw/master/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf"
  [[ -s "$dest/MaterialSymbolsRounded.ttf" ]] || { echo "hush-fonts: Material Symbols download is empty" >&2; exit 1; }
fi

fc-cache -f "$dest" >/dev/null
echo "hush-fonts: done"
