#!/usr/bin/env python3
"""Hush wallpaper generator. Soft layered gradients, blurred shapes, fine grain.
Usage: hush-wallgen <theme|all>. Deterministic from [wallgen].seed in theme.toml."""
import sys, tomllib, pathlib
import numpy as np
from PIL import Image, ImageFilter

ROOT = pathlib.Path(__file__).resolve().parent.parent / "themes"
W, H = 2560, 1440

LIGHT = ("paper", "fog")

PRESETS = {
    # name: (base_top, base_bottom, blobs=[(cx, cy, rx, ry, color, alpha)], grain, horizon, glow_index, ribbons)
    # ribbon = (angle_deg, offset, width, amp, freq, phase, blur, alpha, blob_index); sizes in units of screen height
    "harbor": ("#1b2228", "#0f1417",
               [(0.78, 0.86, 0.55, 0.42, "#2f4a4a", 0.65), (0.22, 0.25, 0.5, 0.35, "#27333a", 0.5),
                (0.82, 0.9, 0.22, 0.16, "#5f8f85", 0.35)], 0.030, None, 0,
               [(-22, -0.18, 0.30, 0.10, 0.9, 0.3, 120, 0.50, 0), (-18, 0.12, 0.24, 0.08, 1.1, 2.1, 100, 0.40, 1),
                (-26, 0.38, 0.22, 0.09, 0.8, 4.0, 130, 0.45, 2)]),
    "ember":  ("#0d0c0c", "#1b1210",
               [(0.5, 1.05, 0.9, 0.5, "#6a3a1f", 0.7), (0.3, 0.95, 0.45, 0.3, "#8a4a22", 0.35),
                (0.75, 0.2, 0.4, 0.3, "#15131a", 0.5)], 0.035, None, 0,
               [(14, 0.22, 0.32, 0.12, 0.7, 1.0, 130, 0.55, 0), (8, 0.40, 0.22, 0.10, 1.2, 3.2, 100, 0.45, 1),
                (20, -0.05, 0.26, 0.08, 0.9, 5.0, 110, 0.35, 0)]),
    "moss":   ("#161b14", "#0e120d",
               [(0.3, 0.4, 0.5, 0.42, "#2d3b26", 0.7), (0.7, 0.65, 0.55, 0.45, "#1f3a33", 0.6),
                (0.5, 0.52, 0.2, 0.18, "#4a5e3a", 0.25)], 0.030, None, 1,
               [(38, -0.25, 0.30, 0.10, 0.8, 0.6, 130, 0.50, 0), (34, 0.05, 0.26, 0.12, 1.0, 2.6, 110, 0.45, 2),
                (42, 0.30, 0.22, 0.09, 1.3, 4.4, 100, 0.40, 1)]),
    "dusk":   ("#2a1f33", "#0e0c14",
               [(0.5, 0.15, 0.8, 0.3, "#4a3358", 0.5), (0.2, 0.75, 0.45, 0.35, "#1c1a2e", 0.6),
                (0.8, 0.8, 0.4, 0.3, "#3b2a48", 0.4)], 0.032, None, 0,
               [(-8, -0.25, 0.35, 0.14, 0.6, 1.5, 140, 0.55, 0), (-4, 0.05, 0.25, 0.10, 1.0, 3.8, 110, 0.45, 2),
                (-12, 0.30, 0.22, 0.12, 0.8, 5.5, 120, 0.40, 0)]),
    "paper":  ("#f1efe9", "#e6e3db",
               [(0.3, 0.3, 0.6, 0.45, "#dfe6e8", 0.55), (0.8, 0.8, 0.5, 0.4, "#e9e4d8", 0.6),
                (0.6, 0.55, 0.25, 0.2, "#cfe0dc", 0.3)], 0.022, None, 2,
               [(-30, -0.20, 0.30, 0.10, 0.9, 0.9, 120, 0.38, 0), (-34, 0.10, 0.24, 0.09, 1.2, 2.9, 100, 0.30, 2),
                (-28, 0.34, 0.26, 0.08, 0.8, 4.6, 130, 0.28, 1)]),
    "fog":    ("#e9ecef", "#cfd5db",
               [(0.5, 0.45, 0.9, 0.22, "#f4f6f8", 0.7), (0.15, 0.85, 0.5, 0.35, "#c3ccd4", 0.5),
                (0.85, 0.2, 0.4, 0.3, "#dde3e8", 0.5)], 0.020, None, 1,
               [(2, -0.22, 0.34, 0.07, 0.6, 2.4, 140, 0.35, 1), (-3, 0.06, 0.28, 0.06, 0.9, 0.4, 120, 0.38, 0),
                (6, 0.30, 0.24, 0.08, 1.1, 3.6, 100, 0.30, 2)]),
}

def hex_rgb(h):
    h = h.lstrip("#"); return np.array([int(h[i:i+2], 16) for i in (0, 2, 4)], dtype=np.float32)

def vertical(top, bottom):
    t = np.linspace(0, 1, H, dtype=np.float32)[:, None, None]
    return hex_rgb(top) * (1 - t) + hex_rgb(bottom) * t

def blob(img, cx, cy, rx, ry, color, alpha):
    yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
    d = ((xx - cx * W) / (rx * W)) ** 2 + ((yy - cy * H) / (ry * H)) ** 2
    mask = np.clip(1 - d, 0, 1) ** 2 * alpha
    return img * (1 - mask[..., None]) + hex_rgb(color) * mask[..., None]

def horizon(img, y, color, alpha):
    yy = np.arange(H, dtype=np.float32)[:, None, None]
    band = np.exp(-((yy - y * H) / 6.0) ** 2) * alpha
    return img * (1 - band) + hex_rgb(color) * band

def grain(img, amount, rng):
    noise = rng.normal(0, 255 * amount, size=(H, W, 1)).astype(np.float32)
    return img + noise

def ribbon(img, spec, color, rng, light):
    angle, off, width, amp, freq, phase, radius, alpha, _ = spec
    th = np.radians(angle)
    yy, xx = np.mgrid[0:H, 0:W].astype(np.float32) / H
    along = xx * np.cos(th) + yy * np.sin(th)
    across = -xx * np.sin(th) + yy * np.cos(th)
    c0 = -(W / H / 2) * np.sin(th) + 0.5 * np.cos(th)
    f = freq * (1 + rng.uniform(-0.08, 0.08)); ph = phase + rng.uniform(-0.4, 0.4)
    d = across - (c0 + off + amp * np.sin(2 * np.pi * f * along + ph))
    m = np.clip(1 - (d / (width / 2)) ** 2, 0, 1) ** 1.5
    mask = Image.fromarray((m * 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(radius=radius))
    m = np.asarray(mask).astype(np.float32) / 255 * alpha
    col = hex_rgb(color)
    col = np.clip(255 - (255 - col) * 2.2, 0, 255) if light else col + (255 - col) * 0.15
    return img * (1 - m[..., None]) + col * m[..., None]

def vignette(img, light):
    yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
    r2 = ((xx - W / 2) / (W / 2)) ** 2 / 2 + ((yy - H / 2) / (H / 2)) ** 2 / 2
    r2 = r2[..., None]
    if light:
        return img + (255 - img) * 0.04 * r2
    return img * (1 - 0.08 * r2)

def render(name):
    top, bottom, blobs, g, hz, glow_i, ribbons = PRESETS[name]
    light = name in LIGHT
    cfg = tomllib.loads((ROOT / name / "theme.toml").read_text())
    rng = np.random.default_rng(cfg["wallgen"]["seed"])
    img = np.broadcast_to(vertical(top, bottom), (H, W, 3)).copy()
    for r in ribbons:
        img = ribbon(img, r, blobs[r[8]][4], rng, light)
    cx, cy, rx, ry, color, alpha = blobs[glow_i]
    img = blob(img, cx, cy, rx, ry, color, min(alpha + 0.15, 0.9))
    img = vignette(img, light)
    if hz:
        img = horizon(img, *hz)
    img = grain(img, g, rng)
    out = ROOT / name / "wallpaper.png"
    Image.fromarray(np.clip(img, 0, 255).astype(np.uint8)).save(out, optimize=True)
    print(f"hush-wallgen: wrote {out}")

if __name__ == "__main__":
    if len(sys.argv) != 2 or (sys.argv[1] != "all" and sys.argv[1] not in PRESETS):
        print("usage: hush-wallgen <" + "|".join(PRESETS) + "|all>", file=sys.stderr); sys.exit(2)
    for n in (PRESETS if sys.argv[1] == "all" else [sys.argv[1]]):
        render(n)
