#!/usr/bin/env bash
# hush: theme and wallpaper switcher for the Hush rice.
set -euo pipefail
shopt -s inherit_errexit

HUSH_ROOT="${HUSH_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
THEMES="$HUSH_ROOT/themes"
STATE_DIR="$HOME/.config/hush"
CACHE_DIR="$HOME/.cache/hush"
HUSH_PROC='^qs -c hush$' # anchored: never match a shell whose command line mentions qs
# pgrep/pkill limited to this session (processes with our XDG_RUNTIME_DIR): tests/sandbox.sh runs a
# second session on the same process table, and neither may signal the other's shell, kitty or bar.
session_pgrep() { # pgrep-args...; prints the pids, fails when there are none
  local p out=""
  for p in $(pgrep "$@"); do
    if [[ -z "${XDG_RUNTIME_DIR:-}" ]] || tr '\0' '\n' </proc/"$p"/environ 2>/dev/null | grep -qxF "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"; then
      out+="$p"$'\n'
    fi
  done
  [[ -n "$out" ]] && printf '%s' "$out"
}
session_pkill() { # [-SIGNAL] pgrep-args...
  local sig=-TERM pids; [[ "$1" == -[A-Z0-9]* ]] && { sig=$1; shift; }
  pids=$(session_pgrep "$@") && kill "$sig" $pids 2>/dev/null
}
STATE="$STATE_DIR/state.json"
MATUGEN_CFG="$CACHE_DIR/matugen.toml"
RENDER="$CACHE_DIR/render"

die() { echo "hush: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }

usage() {
  cat <<EOF
usage: hush <command>
  --version            print the Hush version
  list                 list themes
  theme <name|next|prev> [--from X,Y]
                       apply a theme (wallpaper + colors + reloads); the wallpaper grows
                       from X,Y in pixels (default: the island centre on the focused monitor)
  wall <path|random> [--mode light|dark] [--from X,Y]
                       change wallpaper; colours come from the image, mode from its
                       brightness (mean luminance > 140 = light), theme name is kept.
                       random picks from the themes' own wallpapers, plus every directory
                       in HUSH_WALL_DIRS (colon-separated) when set
  reload               re-render templates for the current state
  status               print active theme, wallpaper, mode, scheme
  install [opts]       link this checkout into ~/.config (install.sh; packaged copies skip the fonts)
  lock                 lock the screen (Quickshell session lock)
  settings             open (or close) the settings surface in the island
  overview             open the GloView overview (hyprctl gloview)
  shell <start|stop|restart|status|log>  manage the Hush Quickshell shell
  volume up|down|mute|mic-mute [step]  change output volume (step %, default 5, capped at 100) or toggle mute
  brightness up|down [step]  change screen brightness (step %, default 5, never fully off)
  timer <N>m|<N>s|<N>h|stop  start a countdown shown at rest in the island, or cancel it
EOF
}

toml_get() { # file key  (flat keys only; [wallgen] seed read separately)
  python3 - "$1" "$2" <<'PY'
import sys, tomllib
d = tomllib.load(open(sys.argv[1], "rb"))
v = d
for part in sys.argv[2].split("."):
    v = v[part]
print(v)
PY
}

list_themes() { # only directories that hold a theme.toml
  local d; for d in "$THEMES"/*/; do if [[ -f "$d/theme.toml" ]]; then basename "$d"; fi; done | sort
}

resolve_theme() { # name -> echoes name or dies
  local n="$1"
  if [[ "$n" == "next" ]]; then
    local cur; cur=$(current_theme)
    n=$(list_themes | awk -v c="$cur" '{a[NR]=$0; if($0==c) i=NR} END{print (i<NR)?a[i+1]:a[1]}')
  elif [[ "$n" == "prev" ]]; then
    local cur; cur=$(current_theme)
    n=$(list_themes | awk -v c="$cur" '{a[NR]=$0; if($0==c) i=NR} END{print (i>1)?a[i-1]:a[NR]}')
  fi
  [[ -f "$THEMES/$n/theme.toml" ]] || die "no theme named \"$n\""
  echo "$n"
}

current_theme() { [[ -f "$STATE" ]] && python3 -c "import json;print(json.load(open('$STATE')).get('theme','harbor'))" || echo harbor; }
current_wall()  { [[ -f "$STATE" ]] && python3 -c "import json;print(json.load(open('$STATE')).get('wallpaper',''))" || echo ""; }

# The config.d fragments carry @HUSH_ROOT@ (template inputs) and @CONFIG@ (output targets,
# normally ~/.config); they are substituted here so no path in the repo is absolute.
assemble_config() {
  mkdir -p "$CACHE_DIR" "$STATE_DIR"
  { cat "$HUSH_ROOT/matugen/config.toml.head"; for f in "$HUSH_ROOT"/matugen/config.d/*.toml; do echo; cat "$f"; done; } \
    | sed -e "s|@HUSH_ROOT@|$HUSH_ROOT|g" -e "s|@CONFIG@|$CONFIG_HOME|g" > "$MATUGEN_CFG"
}

# Render every template into $RENDER (paths mirrored), then move into place. Atomic on failure.
render() { # theme wallpaper [mode-override] [force-image: 1 derives colours from the image]
  local theme="$1" wall="$2" mode_override="${3:-}" force_image="${4:-}"
  local mode scheme source contrast
  mode=$(toml_get "$THEMES/$theme/theme.toml" mode)
  scheme=$(toml_get "$THEMES/$theme/theme.toml" scheme)
  source=$(toml_get "$THEMES/$theme/theme.toml" source)
  [[ -z "$mode_override" ]] || mode="$mode_override"
  if [[ "$force_image" == 1 ]]; then
    [[ "$source" == "wallpaper" ]] || scheme="scheme-tonal-spot"
    source="wallpaper"
  fi
  contrast=$(toml_get "$THEMES/$theme/theme.toml" contrast)
  assemble_config
  rm -rf "$RENDER"; mkdir -p "$RENDER"
  # Rewrite output paths into the render dir so a failure never touches live files.
  local rcfg="$CACHE_DIR/matugen.render.toml"
  sed -E "s|^output_path = '(.*)'|output_path = '$RENDER\\1'|" "$MATUGEN_CFG" > "$rcfg"
  grep -oE "^output_path = '$RENDER[^']+'" "$rcfg" | sed -E "s|^output_path = '(.*)'|\\1|" | xargs -d '\n' -I{} dirname {} | sort -u | xargs -d '\n' mkdir -p || die "could not prepare render dirs"
  if grep -E "^output_path = " "$rcfg" | grep -vqE "^output_path = '$RENDER/"; then
    die "an output_path is not single-quoted-absolute; see $rcfg"
  fi
  if [[ "$source" == "wallpaper" ]]; then
    matugen image "$wall" -c "$rcfg" -m "$mode" -t "$scheme" --contrast "$contrast" --source-color-index 0 -q \
      || die "matugen failed for theme $theme (image $wall)"
  else
    matugen color hex "$source" -c "$rcfg" -m "$mode" -t "$scheme" --contrast "$contrast" -q \
      || die "matugen failed for theme $theme (color $source)"
  fi
  # Every declared output must exist in the render dir, otherwise refuse.
  while read -r out; do
    [[ -s "$RENDER$out" ]] || die "template produced no output for $out"
  done < <(grep -oE "^output_path = '[^']+'" "$MATUGEN_CFG" | sed -E "s|^output_path = '(.*)'|\\1|")
  (cd "$RENDER" && find . -type f -print0) | while IFS= read -r -d '' f; do
    local dest="${f#.}"
    mkdir -p "$(dirname "$dest")" || die "failed to install $dest"
    mv -f "$RENDER/$f" "$dest" || die "failed to install $dest"
  done
  echo "$mode"
}

# state.json is the "theme applied" signal the shell watches: always written LAST,
# after Colors.json (render), the wallpaper and the consumer reloads.
write_state() { # theme wallpaper mode [scheme source]  (scheme/source default to the theme's own)
  local theme="$1" wall="$2" mode="$3"
  local scheme="${4:-$(toml_get "$THEMES/$theme/theme.toml" scheme)}" source="${5:-$(toml_get "$THEMES/$theme/theme.toml" source)}"
  python3 - "$STATE" "$theme" "$wall" "$mode" "$scheme" "$source" <<'PY'
import json, os, sys, datetime
p, theme, wall, mode, scheme, source = sys.argv[1:]
tmp = p + ".tmp"
with open(tmp, "w") as f:
    json.dump({"theme": theme, "wallpaper": wall, "mode": mode, "scheme": scheme, "source": source,
               "applied_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds")},
              f, indent=2)
    f.flush(); os.fsync(f.fileno())
os.replace(tmp, p)  # atomic: watchers never see a truncated state.json
PY
}

# Circle-reveal transition args for awww. FROM_XY (validated "X,Y" px) else island centre.
# Reduced motion (HUSH_REDUCED_MOTION=1 or settings island.reducedMotion) -> instant simple.
transition_args() {
  local rm="${HUSH_REDUCED_MOTION:-}"
  if [[ -z "$rm" && -f "$STATE_DIR/settings.json" ]]; then
    rm=$(python3 -c "import json,sys;print('1' if json.load(open(sys.argv[1])).get('island',{}).get('reducedMotion') is True else '')" "$STATE_DIR/settings.json" 2>/dev/null || true)
  fi
  if [[ "$rm" == 1 ]]; then echo "--transition-type simple --transition-step 255"; return; fi
  local pos="${FROM_XY:-}"
  if [[ -z "$pos" ]]; then
    pos=$(hyprctl monitors -j 2>/dev/null | python3 -c "
import json,sys
try:
    m=[x for x in json.load(sys.stdin) if x.get('focused')][0]
    print('%d,%d' % (m['x']+m['width']//2, m['y']+6+18))
except Exception: pass" 2>/dev/null || true)
  fi
  local out="--transition-type grow"
  [[ -n "$pos" ]] && out+=" --transition-pos $pos"
  echo "$out --transition-duration 0.9 --transition-fps 60 --transition-bezier .16,1,.3,1"
}

check_from() { [[ "$1" =~ ^[0-9]+,[0-9]+$ ]] || die "--from needs integer pixels X,Y (got \"$1\")"; FROM_XY="$1"; }

set_wallpaper() { # path
  local wall="$1" i
  if command -v awww >/dev/null; then
    # At login awww-daemon may still be starting; give it up to 5 s.
    for ((i = 0; i < 50; i++)); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
    if awww query >/dev/null 2>&1; then
      awww img "$wall" $(transition_args) >/dev/null 2>&1 || echo "hush: awww failed (continuing)" >&2
    else
      echo "hush: awww-daemon not answering after 5 s; wallpaper not set (continuing)" >&2
    fi
  fi
}

cmd_lock() { # the Quickshell lock runs as its own process, so a shell restart cannot unlock
  [[ -z "${1:-}" ]] || die "usage: hush lock"
  need qs
  # quiet on the terminal; Quickshell keeps its own log under $XDG_RUNTIME_DIR/quickshell
  HUSH_ROOT=$HUSH_ROOT exec qs -n -p "$HUSH_ROOT/quickshell/hush/lock.qml" >/dev/null 2>&1
}

reload_consumers() { # theme mode
  local theme="$1" mode="$2" icon
  icon=$(toml_get "$THEMES/$theme/theme.toml" icon_theme)
  if command -v hyprctl >/dev/null && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload >/dev/null 2>&1 || echo "hush: hyprctl reload failed" >&2
  fi
  session_pkill -USR1 -x kitty 2>/dev/null || true
  # fastfetch shows the Breath mark through kitty graphics; matugen renders the tinted SVG, kitty wants PNG.
  local ff="$CONFIG_HOME/fastfetch"
  if [[ -s "$ff/hush-logo.svg" ]] && command -v rsvg-convert >/dev/null; then
    { rsvg-convert -w 512 "$ff/hush-logo.svg" -o "$ff/hush-logo.png.tmp" && mv -f "$ff/hush-logo.png.tmp" "$ff/hush-logo.png"; } \
      || echo "hush: fastfetch logo render failed (continuing)" >&2
  fi
  if command -v gsettings >/dev/null; then
    if [[ "$mode" == "light" ]]; then
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' || echo "hush: gsettings failed (continuing)" >&2
      gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3' || echo "hush: gsettings failed (continuing)" >&2
    else
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || echo "hush: gsettings failed (continuing)" >&2
      gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' || echo "hush: gsettings failed (continuing)" >&2
    fi
    gsettings set org.gnome.desktop.interface icon-theme "$icon" || echo "hush: gsettings failed (continuing)" >&2
  fi
  mkdir -p "$HOME/.config/Kvantum"
  printf '[General]\ntheme=hush\n' > "$HOME/.config/Kvantum/kvantum.kvconfig"
  if [[ -d "$HOME/.config/quickshell/hush" ]] && command -v qs >/dev/null; then
    : # the shell watches Colors.json; nothing to do
  fi
}

cmd_theme() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) [[ $# -ge 2 ]] || die "--from needs X,Y"; check_from "$2"; shift 2 ;;
      *) name="$1"; shift ;;
    esac
  done
  local theme; theme=$(resolve_theme "$name")
  local wall="$THEMES/$theme/wallpaper.png"
  [[ -f "$wall" ]] || die "theme $theme has no wallpaper.png (run bin/hush-wallgen $theme)"
  local mode; mode=$(render "$theme" "$wall")
  set_wallpaper "$wall"
  reload_consumers "$theme" "$mode"
  write_state "$theme" "$wall" "$mode"
  echo "hush: applied $theme ($mode)"
}

wall_mode() { # image -> light|dark by mean luminance
  python3 - "$1" <<'PY'
import sys
from PIL import Image, ImageStat
im = Image.open(sys.argv[1]).convert("L")
im.thumbnail((256, 256))
print("light" if ImageStat.Stat(im).mean[0] > 140 else "dark")
PY
}

cmd_wall() {
  local wall="" mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode) mode="${2:-}"; shift 2 || die "--mode needs light or dark" ;;
      --from) [[ $# -ge 2 ]] || die "--from needs X,Y"; check_from "$2"; shift 2 ;;
      *) wall="$1"; shift ;;
    esac
  done
  [[ -z "$mode" || "$mode" == light || "$mode" == dark ]] || die "--mode must be light or dark"
  if [[ "$wall" == "random" ]]; then
    local -a dirs=("$THEMES"); local d
    if [[ -n "${HUSH_WALL_DIRS:-}" ]]; then IFS=: read -ra extra <<<"$HUSH_WALL_DIRS"; for d in "${extra[@]}"; do [[ -d "$d" ]] && dirs+=("$d"); done; fi
    wall=$( { find "${dirs[@]}" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) 2>/dev/null || true; } | shuf -n1 || true)
    [[ -n "$wall" ]] || die "no wallpapers found"
  fi
  [[ -f "$wall" ]] || die "no such wallpaper: $wall"
  wall=$(realpath "$wall")
  local theme; theme=$(current_theme)
  [[ -n "$mode" ]] || mode=$(wall_mode "$wall") || die "could not read wallpaper brightness: $wall"
  local scheme; scheme=$(toml_get "$THEMES/$theme/theme.toml" scheme)
  [[ "$(toml_get "$THEMES/$theme/theme.toml" source)" == wallpaper ]] || scheme="scheme-tonal-spot"
  render "$theme" "$wall" "$mode" 1 >/dev/null
  set_wallpaper "$wall"
  reload_consumers "$theme" "$mode"
  write_state "$theme" "$wall" "$mode" "$scheme" wallpaper
  echo "hush: wallpaper set ($theme, $mode)"
}

cmd_reload() {
  local theme wall; theme=$(current_theme); wall=$(current_wall)
  [[ -f "$wall" ]] || wall="$THEMES/$theme/wallpaper.png"
  local mode; mode=$(render "$theme" "$wall")
  set_wallpaper "$wall"
  reload_consumers "$theme" "$mode"
  write_state "$theme" "$wall" "$mode"
  echo "hush: reloaded $theme"
}

cmd_status() {
  [[ -f "$STATE" ]] || die "no state yet; run: hush theme harbor"
  python3 -c "
import json; s=json.load(open('$STATE'))
print('theme', s['theme']); print('wallpaper', s['wallpaper']); print('mode', s['mode']); print('scheme', s['scheme']); print('source', s['source']); print('applied', s['applied_at'])"
}

cmd_shell() {
  local log="$CACHE_DIR/shell.log"; mkdir -p "$CACHE_DIR"
  case "${1:-}" in
    start)
      session_pgrep -f "$HUSH_PROC" >/dev/null && { echo "hush shell: already running"; return 0; }
      if [[ -f "$log" ]]; then wc -l < "$log"; else echo 0; fi > "$CACHE_DIR/shell.restart-marker"
      (setsid nohup qs -c hush >>"$log" 2>&1 </dev/null 9>&- &)
      local i out; for i in $(seq 1 40); do
        out=$(qs -c hush ipc call hush ping 2>/dev/null || true)
        [[ "$out" == pong ]] && { echo "hush shell: up"; return 0; }
        sleep 0.25
      done
      echo "hush shell: did not answer ping within 10 s (see $log)" >&2; return 1 ;;
    stop)
      session_pkill -f "$HUSH_PROC" 2>/dev/null || true
      local i; for i in $(seq 1 20); do session_pgrep -f "$HUSH_PROC" >/dev/null || break; sleep 0.1; done
      if session_pgrep -f "$HUSH_PROC" >/dev/null; then # ignored SIGTERM: escalate
        session_pkill -KILL -f "$HUSH_PROC" 2>/dev/null || true
        for i in $(seq 1 20); do session_pgrep -f "$HUSH_PROC" >/dev/null || break; sleep 0.1; done
      fi
      if session_pgrep -f "$HUSH_PROC" >/dev/null; then echo "hush shell: could not stop" >&2; return 1; fi
      echo "hush shell: stopped" ;;
    restart) cmd_shell stop || return 1; cmd_shell start ;; # stop guarantees a fresh start and marker
    status)
      if session_pgrep -f "$HUSH_PROC" >/dev/null; then echo "alive"; else echo "dead"; fi
      { hyprctl layers -j 2>/dev/null || true; } | { grep -oE '"namespace": "hush-[a-z-]+"' || true; } | sort -u ;;
    log) tail -n 50 "$log" ;;
    *) die "usage: hush shell start|stop|restart|status|log" ;;
  esac
}

cmd_timer() { # <N>[smh] | stop  (talks to the running shell's activity IPC)
  local a="${1:-}" n u secs
  [[ -n "$a" ]] || die "usage: hush timer <N>m|<N>s|<N>h|stop"
  if [[ "$a" == "stop" ]]; then qs -c hush ipc call activity timerStop >/dev/null || die "the shell is not running"; return; fi
  [[ "$a" =~ ^([0-9]+)([smh]?)$ ]] || die "bad duration \"$a\" (use e.g. 25m, 90s, 1h)"
  n="${BASH_REMATCH[1]}"; u="${BASH_REMATCH[2]:-m}"
  case "$u" in s) secs=$n ;; m) secs=$((n * 60)) ;; h) secs=$((n * 3600)) ;; esac
  [[ "$secs" -gt 0 ]] || die "duration must be positive"
  qs -c hush ipc call activity timerStart "$secs" >/dev/null || die "the shell is not running"
}

cmd_volume() { # up|down|mute|mic-mute [step]; the island's Audio service shows the OSD
  local act="${1:-}" step="${2:-5}"
  [[ "$step" =~ ^[0-9]+$ ]] || die "bad step \"$step\" (use a whole number of percent)"
  need wpctl
  case "$act" in
    up)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${step}%+" ;;
    down) wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}%-" ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    *) die "usage: hush volume up|down|mute|mic-mute [step]" ;;
  esac
}

cmd_brightness() { # up|down [step]
  local act="${1:-}" step="${2:-5}"
  [[ "$step" =~ ^[0-9]+$ ]] || die "bad step \"$step\" (use a whole number of percent)"
  need brightnessctl
  case "$act" in
    up)   brightnessctl -q set "${step}%+" ;;
    down) brightnessctl -q --min-value=1 set "${step}%-" ;;
    *) die "usage: hush brightness up|down [step]" ;;
  esac
}

main() {
  need python3
  case "${1:-}" in theme|wall|reload) need matugen ;; esac
  mkdir -p "$CACHE_DIR" "$STATE_DIR"
  # Serialize every mutating command: they share $RENDER and $MATUGEN_CFG.
  case "${1:-}" in
    list|status|overview|shell|timer|volume|brightness|settings|lock|""|-h|--help|help|--version|version) ;; # shell does not render; it must not hold the lock
    *) exec 9>"$CACHE_DIR/lock"; flock -w 30 9 || die "another hush is running" ;;
  esac
  case "${1:-}" in
    list) list_themes ;;
    theme) shift; cmd_theme "$@" ;;
    wall) shift; cmd_wall "$@" ;;
    reload) cmd_reload ;;
    status) cmd_status ;;
    overview) command -v hyprctl >/dev/null || die "hyprctl not found"; hyprctl gloview ;;
    shell) cmd_shell "${2:-}" ;;
    timer) cmd_timer "${2:-}" ;;
    volume) shift; cmd_volume "$@" ;;
    brightness) shift; cmd_brightness "$@" ;;
    lock) cmd_lock "${2:-}" ;;
    install) shift; [[ $# -eq 0 && ( "$HUSH_ROOT" == /usr/* || "$HUSH_ROOT" == /nix/* || "$HUSH_ROOT" == */.nix-profile/* ) ]] && set -- --no-fonts; exec "$HUSH_ROOT/install.sh" "$@" ;;
    settings) qs -c hush ipc call hush settings >/dev/null || die "the shell is not running" ;;
    --version|version) cat "$HUSH_ROOT/VERSION" ;;
    ""|-h|--help|help) usage ;;
    *) usage; die "unknown command: $1" ;;
  esac
}
main "$@"
