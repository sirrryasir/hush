#!/usr/bin/env bash
# Gate every commit: nothing personal in the tree, and the live generated config is valid.
cd "$(git rev-parse --show-toplevel)" || exit 1
bash tests/test_no_personal.sh >/dev/null || { bash tests/test_no_personal.sh; exit 1; }
HUSH_CHECK_NO_HYPR=${HYPRLAND_INSTANCE_SIGNATURE:+0}
HUSH_CHECK_NO_HYPR=${HUSH_CHECK_NO_HYPR:-1} bin/hush check
